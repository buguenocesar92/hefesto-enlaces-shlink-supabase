# Copiar a .env SOLO en servidor. No subir a Git.
# Contrato auditable de variables: ninguna tiene valor real.
COMPOSE_PROJECT_NAME=hefesto-enlaces
POSTGRES_HOST=db.REEMPLAZAR.supabase.co
POSTGRES_USERNAME=shlink_app
POSTGRES_PASSWORD=GENERAR
LINKS_HOST=enlaces.tu-dominio.cl
PANEL_HOST=panel-enlaces.tu-dominio.cl
SUPABASE_DEDICATED_CONFIRMED=true
SUPABASE_DATA_API_DISABLED=true
# Solo los proxies reales del cliente: IPs o CIDR separados por coma.
TRUSTED_PROXIES=127.0.0.1
DB_HOST=db.REEMPLAZAR.supabase.co
DB_NAME=postgres
DB_PASSWORD=GENERAR
DB_SSLMODE=require
DB_SSLROOTCERT=/run/supabase/ca.crt
INITIAL_API_KEY=GENERAR
INITIAL_SETUP_COMPLETE=false
APP_URL=https://enlaces.tu-dominio.cl
APP_HOST=enlaces.tu-dominio.cl
