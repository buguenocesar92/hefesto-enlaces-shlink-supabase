{
  "software": "hefesto-enlaces",
  "version": "5.1.7",
  "database": "supabase-postgresql",
  "piezas": [
    "public.dump"
  ],
  "requiere": [
    "app"
  ],
  "arranca": [
    "app"
  ],
  "pasos": [
    [
      "stop",
      "app"
    ],
    [
      "pieza",
      "public.dump"
    ]
  ],
  "comandos": {
    "public.dump": [
      "run",
      "--rm",
      "--no-deps",
      "-T",
      "--entrypoint",
      "pg_dump",
      "dbtools",
      "--format=custom",
      "--schema=public",
      "--no-owner",
      "--no-acl"
    ]
  },
  "env_requeridas": [
    "POSTGRES_HOST",
    "POSTGRES_USERNAME",
    "POSTGRES_PASSWORD",
    "LINKS_HOST",
    "PANEL_HOST",
    "TRUSTED_PROXIES",
    "DB_HOST",
    "DB_NAME",
    "DB_PASSWORD",
    "DB_SSLMODE"
  ],
  "env_secretas": [
    "POSTGRES_PASSWORD",
    "DB_PASSWORD",
    "INITIAL_API_KEY"
  ],
  "env_min_len": 32,
  "env_reglas": []
}
